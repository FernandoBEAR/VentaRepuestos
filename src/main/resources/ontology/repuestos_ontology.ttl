@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <http://schema.org/> .
@prefix gr:     <http://purl.org/goodrelations/v1#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix vr:     <http://www.ventarepuestos.com/ontology#> .

# =============================================================================
# ONTOLOGÍA OWL - Definición del dominio VentaRepuestos
# =============================================================================

vr: a owl:Ontology ;
    rdfs:label "Ontología de Venta de Repuestos" ;
    rdfs:comment "Ontología OWL que modela el dominio de una tienda de repuestos, incluyendo productos, clientes, ventas y pagos." .

# --- Clases OWL ---

vr:Repuesto a owl:Class ;
    rdfs:subClassOf gr:ProductOrServiceModel ;
    rdfs:label "Repuesto" ;
    rdfs:comment "Un repuesto o producto disponible para la venta." .

vr:Cliente a owl:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label "Cliente" ;
    rdfs:comment "Una persona que compra repuestos." .

vr:Venta a owl:Class ;
    rdfs:subClassOf schema:Order ;
    rdfs:label "Venta" ;
    rdfs:comment "Una transacción de venta de repuestos a un cliente." .

vr:Pago a owl:Class ;
    rdfs:subClassOf schema:PayAction ;
    rdfs:label "Pago" ;
    rdfs:comment "Un pago asociado a una venta." .

vr:DetalleVenta a owl:Class ;
    rdfs:label "DetalleVenta" ;
    rdfs:comment "Línea de detalle de una venta: repuesto, cantidad y subtotal." .

vr:Movimiento a owl:Class ;
    rdfs:label "Movimiento" ;
    rdfs:comment "Movimiento de inventario (entrada, venta, devolución) sobre un repuesto." .

# --- Propiedades OWL (Object Properties) ---

vr:tieneMarca a owl:ObjectProperty ;
    rdfs:domain vr:Repuesto ;
    rdfs:range skos:Concept ;
    rdfs:label "tiene marca" .

vr:tieneCliente a owl:ObjectProperty ;
    rdfs:domain vr:Venta ;
    rdfs:range vr:Cliente ;
    rdfs:label "tiene cliente" .

vr:tienePago a owl:ObjectProperty ;
    rdfs:domain vr:Venta ;
    rdfs:range vr:Pago ;
    rdfs:label "tiene pago" .

vr:tieneMetodoPago a owl:ObjectProperty ;
    rdfs:domain vr:Pago ;
    rdfs:range skos:Concept ;
    rdfs:label "tiene método de pago" .

vr:tieneDetalle a owl:ObjectProperty ;
    rdfs:domain vr:Venta ;
    rdfs:range vr:DetalleVenta ;
    rdfs:label "tiene detalle de venta" .

vr:detalleRepuesto a owl:ObjectProperty ;
    rdfs:domain vr:DetalleVenta ;
    rdfs:range vr:Repuesto ;
    rdfs:label "repuesto del detalle" .

vr:movimientoRepuesto a owl:ObjectProperty ;
    rdfs:domain vr:Movimiento ;
    rdfs:range vr:Repuesto ;
    rdfs:label "repuesto del movimiento" .

vr:tieneTipoMovimiento a owl:ObjectProperty ;
    rdfs:domain vr:Movimiento ;
    rdfs:range skos:Concept ;
    rdfs:label "tipo de movimiento" .

# --- Propiedades OWL (Datatype Properties) ---

vr:precio a owl:DatatypeProperty ;
    rdfs:domain vr:Repuesto ;
    rdfs:range xsd:double ;
    rdfs:label "precio" .

vr:stock a owl:DatatypeProperty ;
    rdfs:domain vr:Repuesto ;
    rdfs:range xsd:integer ;
    rdfs:label "stock disponible" .

vr:descripcion a owl:DatatypeProperty ;
    rdfs:domain vr:Repuesto ;
    rdfs:range xsd:string ;
    rdfs:label "descripción" .

vr:email a owl:DatatypeProperty ;
    rdfs:domain vr:Cliente ;
    rdfs:range xsd:string ;
    rdfs:label "correo electrónico" .

vr:totalVenta a owl:DatatypeProperty ;
    rdfs:domain vr:Venta ;
    rdfs:range xsd:double ;
    rdfs:label "total de la venta" .

vr:montoPago a owl:DatatypeProperty ;
    rdfs:domain vr:Pago ;
    rdfs:range xsd:double ;
    rdfs:label "monto del pago" .

vr:estadoPago a owl:DatatypeProperty ;
    rdfs:domain vr:Pago ;
    rdfs:range xsd:string ;
    rdfs:label "estado del pago" .

vr:tipoComprobante a owl:DatatypeProperty ;
    rdfs:domain vr:Pago ;
    rdfs:range xsd:string ;
    rdfs:label "tipo de comprobante" .

vr:fechaPago a owl:DatatypeProperty ;
    rdfs:domain vr:Pago ;
    rdfs:range xsd:string ;
    rdfs:label "fecha del pago" .

vr:cantidadDetalle a owl:DatatypeProperty ;
    rdfs:domain vr:DetalleVenta ;
    rdfs:range xsd:integer ;
    rdfs:label "cantidad en el detalle" .

vr:precioUnitario a owl:DatatypeProperty ;
    rdfs:domain vr:DetalleVenta ;
    rdfs:range xsd:double ;
    rdfs:label "precio unitario" .

vr:subtotal a owl:DatatypeProperty ;
    rdfs:domain vr:DetalleVenta ;
    rdfs:range xsd:double ;
    rdfs:label "subtotal del detalle" .

vr:cantidadMovimiento a owl:DatatypeProperty ;
    rdfs:domain vr:Movimiento ;
    rdfs:range xsd:integer ;
    rdfs:label "cantidad del movimiento" .

vr:diaMovimiento a owl:DatatypeProperty ;
    rdfs:domain vr:Movimiento ;
    rdfs:range xsd:integer ;
    rdfs:label "día del movimiento" .

vr:mesMovimiento a owl:DatatypeProperty ;
    rdfs:domain vr:Movimiento ;
    rdfs:range xsd:integer ;
    rdfs:label "mes del movimiento" .

vr:anioMovimiento a owl:DatatypeProperty ;
    rdfs:domain vr:Movimiento ;
    rdfs:range xsd:integer ;
    rdfs:label "año del movimiento" .

# =============================================================================
# SKOS - Taxonomías y Esquemas de Conceptos
# =============================================================================

# --- Esquema de Marcas ---
vr:EsquemaMarcas a skos:ConceptScheme ;
    skos:prefLabel "Marcas de Repuestos" ;
    skos:definition "Taxonomía de marcas disponibles en la tienda." .

vr:MarcaTrupper a skos:Concept ;
    skos:inScheme vr:EsquemaMarcas ;
    skos:prefLabel "TRUPPER" ;
    skos:definition "Marca de herramientas y repuestos Trupper." .

vr:MarcaStanley a skos:Concept ;
    skos:inScheme vr:EsquemaMarcas ;
    skos:prefLabel "STANLEY" ;
    skos:definition "Marca de herramientas y repuestos Stanley." .

vr:MarcaBosch a skos:Concept ;
    skos:inScheme vr:EsquemaMarcas ;
    skos:prefLabel "BOSCH" ;
    skos:definition "Marca de herramientas y repuestos Bosch." .

# --- Esquema de Métodos de Pago ---
vr:EsquemaMetodosPago a skos:ConceptScheme ;
    skos:prefLabel "Métodos de Pago" ;
    skos:definition "Formas de pago aceptadas." .

vr:PagoEfectivo a skos:Concept ;
    skos:inScheme vr:EsquemaMetodosPago ;
    skos:prefLabel "EFECTIVO" .

vr:PagoTarjetaCredito a skos:Concept ;
    skos:inScheme vr:EsquemaMetodosPago ;
    skos:prefLabel "TARJETA_CREDITO" .

vr:PagoTarjetaDebito a skos:Concept ;
    skos:inScheme vr:EsquemaMetodosPago ;
    skos:prefLabel "TARJETA_DEBITO" .

vr:PagoTransferencia a skos:Concept ;
    skos:inScheme vr:EsquemaMetodosPago ;
    skos:prefLabel "TRANSFERENCIA" .

vr:PagoYape a skos:Concept ;
    skos:inScheme vr:EsquemaMetodosPago ;
    skos:prefLabel "YAPE" .

vr:PagoPlin a skos:Concept ;
    skos:inScheme vr:EsquemaMetodosPago ;
    skos:prefLabel "PLIN" .

# --- Esquema de Tipos de Movimiento ---
vr:EsquemaTiposMovimiento a skos:ConceptScheme ;
    skos:prefLabel "Tipos de Movimiento de Inventario" .

vr:MovimientoVenta a skos:Concept ;
    skos:inScheme vr:EsquemaTiposMovimiento ;
    skos:prefLabel "VENTA" .

vr:MovimientoDevolucion a skos:Concept ;
    skos:inScheme vr:EsquemaTiposMovimiento ;
    skos:prefLabel "DEVOLUCION" .

vr:MovimientoEntrada a skos:Concept ;
    skos:inScheme vr:EsquemaTiposMovimiento ;
    skos:prefLabel "ENTRADA" .

# --- Esquema de Estados de Pago ---
vr:EsquemaEstadosPago a skos:ConceptScheme ;
    skos:prefLabel "Estados de Pago" .

vr:EstadoPagado a skos:Concept ;
    skos:inScheme vr:EsquemaEstadosPago ;
    skos:prefLabel "PAGADO" .

vr:EstadoPendiente a skos:Concept ;
    skos:inScheme vr:EsquemaEstadosPago ;
    skos:prefLabel "PENDIENTE" .

vr:EstadoAnulado a skos:Concept ;
    skos:inScheme vr:EsquemaEstadosPago ;
    skos:prefLabel "ANULADO" .

# --- Esquema de Tipos de Comprobante ---
vr:EsquemaTiposComprobante a skos:ConceptScheme ;
    skos:prefLabel "Tipos de Comprobante" .

vr:ComprobanteBoleta a skos:Concept ;
    skos:inScheme vr:EsquemaTiposComprobante ;
    skos:prefLabel "BOLETA" .

vr:ComprobanteFactura a skos:Concept ;
    skos:inScheme vr:EsquemaTiposComprobante ;
    skos:prefLabel "FACTURA" .

vr:ComprobanteTicket a skos:Concept ;
    skos:inScheme vr:EsquemaTiposComprobante ;
    skos:prefLabel "TICKET" .

# =============================================================================
# NOTA: Las instancias de Repuesto y Cliente se cargan dinámicamente
#       desde la base de datos al arrancar la aplicación (OntologyLoaderService).
#       Este archivo solo contiene el esquema OWL y las taxonomías SKOS.
# =============================================================================

